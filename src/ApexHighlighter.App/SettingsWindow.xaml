<Window x:Class="ApexHighlighter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ApexHighlighter.App"
        Title="{l:Tr set.title}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1F2229" Foreground="#E6E8EE" FontFamily="{l:Tr app.font}" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="{l:Tr set.uiLang}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="UiLanguageBox" Width="220" HorizontalAlignment="Left"
                  DisplayMemberPath="NativeName" SelectionChanged="UiLanguageBox_SelectionChanged"
                  AutomationProperties.Name="{l:Tr set.uiLang}"/>
        <TextBlock Text="{l:Tr set.uiLangNote}" TextWrapping="Wrap" Foreground="#9AA1AE" FontSize="12" Margin="0,8,0,0"/>
        <Button Content="{l:Tr set.close}" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="16,5" IsCancel="True" IsDefault="True"
                Click="Close_Click" Foreground="#E6E8EE" Background="#2A2E37" BorderBrush="#3A3F4A"/>
    </StackPanel>
</Window>
