<Window x:Class="ApexHighlighter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apex 精華挑片" Height="820" Width="1360" MinWidth="1000" MinHeight="640"
        Background="#16181D" Foreground="#E6E8EE" FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1F2229"/>
        <SolidColorBrush x:Key="Line" Color="#2E323B"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA1AE"/>
        <SolidColorBrush x:Key="Accent" Color="#E5484D"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="Background" Value="#2A2E37"/>
            <Setter Property="BorderBrush" Value="#3A3F4A"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#353A45"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C8363B"/>
            <Setter Property="BorderBrush" Value="#E5484D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111318"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#3A3F4A"/>
            <Setter Property="CaretBrush" Value="#E6E8EE"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <Button x:Name="ImportButton" DockPanel.Dock="Left" Click="Import_Click" Style="{StaticResource Primary}">匯入錄影…</Button>
            <Button x:Name="ScanButton" DockPanel.Dock="Left" Click="Scan_Click" IsEnabled="False">掃描精華</Button>
            <Button x:Name="CancelButton" DockPanel.Dock="Left" Click="Cancel_Click" IsEnabled="False">取消</Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}">遊戲語言</TextBlock>
                <ComboBox x:Name="LanguageBox" Width="110" SelectedIndex="0"/>
            </StackPanel>
            <StackPanel Margin="10,0" VerticalAlignment="Center">
                <TextBlock x:Name="FileText" Text="尚未匯入。可直接把 OBS 的 MKV／MP4 拖進視窗。" TextTrimming="CharacterEllipsis"/>
                <Grid Margin="0,4,0,0">
                    <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1" Background="#2A2E37" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                </Grid>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Clip list -->
            <Border Background="{StaticResource Panel}" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="0" Click="AddManual_Click" x:Name="AddButton" IsEnabled="False">＋ 在目前位置新增</Button>
                        <TextBlock FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center">候選片段</TextBlock>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ListHint" Margin="12,0,12,8" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"
                               Text="匯入後按「掃描精華」，或用播放器找到位置後手動新增片段。"/>

                    <!-- Selected clip editor -->
                    <Border DockPanel.Dock="Bottom" x:Name="Editor" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,10" IsEnabled="False">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}">起點</TextBlock>
                                <TextBox Grid.Column="1" x:Name="StartBox" LostFocus="StartBox_Commit" KeyDown="TimeBox_KeyDown" Text="{Binding StartText, Mode=OneWay}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Button Style="{StaticResource Small}" Click="Nudge_Click" Tag="s:-1">−1s</Button>
                                    <Button Style="{StaticResource Small}" Click="Nudge_Click" Tag="s:-0.2">−0.2</Button>
                                    <Button Style="{StaticResource Small}" Click="Nudge_Click" Tag="s:0.2">+0.2</Button>
                                    <Button Style="{StaticResource Small}" Click="Nudge_Click" Tag="s:1">+1s</Button>
                                    <Button Style="{StaticResource Small}" Click="SetHere_Click" Tag="s" ToolTip="把起點設成播放器目前位置（快捷鍵 I）">設為目前</Button>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}">終點</TextBlock>
                                <TextBox Grid.Column="1" x:Name="EndBox" LostFocus="EndBox_Commit" KeyDown="TimeBox_KeyDown" Text="{Binding EndText, Mode=OneWay}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Button Style="{StaticResource Small}" Click="Nudge_Click" Tag="e:-1">−1s</Button>
                                    <Button Style="{StaticResource Small}" Click="Nudge_Click" Tag="e:-0.2">−0.2</Button>
                                    <Button Style="{StaticResource Small}" Click="Nudge_Click" Tag="e:0.2">+0.2</Button>
                                    <Button Style="{StaticResource Small}" Click="Nudge_Click" Tag="e:1">+1s</Button>
                                    <Button Style="{StaticResource Small}" Click="SetHere_Click" Tag="e" ToolTip="把終點設成播放器目前位置（快捷鍵 O）">設為目前</Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Click="PlayClip_Click">▶ 播放這段</Button>
                                <Button Click="PlayTail_Click" ToolTip="從終點前 3 秒播到終點，檢查收尾">▶ 聽結尾</Button>
                                <Button Click="Remove_Click">刪除</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="ClipList" Background="Transparent" BorderThickness="0" Margin="6,0"
                             SelectionChanged="ClipList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ClipList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="card" Background="#252932" CornerRadius="5" BorderThickness="1" BorderBrush="#2E323B" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush" Value="#E5484D"/>
                                                    <Setter TargetName="card" Property="Background" Value="#2C2328"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Keep}" VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="勾選＝匯出；取消勾選＝跳過"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" Foreground="#9AA1AE"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#9AA1AE" FontSize="11.5" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Source}" Foreground="#6E7583" FontSize="11" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#7FD18B" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Player -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid Height="12" x:Name="MarkerHost" Margin="5,0">
                            <Canvas x:Name="Markers" ClipToBounds="True" Background="#22262E"/>
                        </Grid>
                        <Slider x:Name="Timeline" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Margin="0,2,0,0"
                                ValueChanged="Timeline_ValueChanged" PreviewMouseDown="Timeline_MouseDown" PreviewMouseUp="Timeline_MouseUp"/>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" x:Name="TimeText" Text="0:00:00.0 / 0:00:00" VerticalAlignment="Center" FontFamily="Consolas"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PlayButton" Click="PlayPause_Click" Width="80" IsEnabled="False">▶ 播放</Button>
                                <Button Style="{StaticResource Small}" Click="Seek_Click" Tag="-10">−10s</Button>
                                <Button Style="{StaticResource Small}" Click="Seek_Click" Tag="-2">−2s</Button>
                                <Button Style="{StaticResource Small}" Click="Seek_Click" Tag="2">+2s</Button>
                                <Button Style="{StaticResource Small}" Click="Seek_Click" Tag="10">+10s</Button>
                                <TextBlock Style="{StaticResource Label}" Margin="12,0,6,0" FontSize="11.5">空白鍵播放／暫停　←→ 2 秒　I／O 設起訖</TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <Grid Background="Black">
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True" Stretch="Uniform"
                                      MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed" MediaEnded="Player_MediaEnded"/>
                        <TextBlock x:Name="PlayerHint" Text="預覽" Foreground="#555B66" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Export bar -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,10,0,8" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="ExportButton" Style="{StaticResource Primary}" Margin="0" Click="Export_Click" IsEnabled="False">匯出勾選的片段</Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Label}">音軌</TextBlock>
                    <ComboBox x:Name="AudioBox" Width="230" Margin="0,0,16,0"/>
                    <TextBlock Style="{StaticResource Label}">輸出資料夾</TextBlock>
                    <TextBox x:Name="OutDirBox" Width="360" VerticalContentAlignment="Center"/>
                    <Button Style="{StaticResource Small}" Margin="4,0,12,0" Click="BrowseOut_Click">選擇…</Button>
                    <Button Style="{StaticResource Small}" Click="OpenOut_Click">開啟資料夾</Button>
                    <TextBlock x:Name="ExportInfo" Style="{StaticResource Label}" Margin="12,0,0,0" FontSize="11.5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" Background="#111318" Foreground="#AEB5C2" BorderBrush="#2E323B"/>
    </Grid>
</Window>
