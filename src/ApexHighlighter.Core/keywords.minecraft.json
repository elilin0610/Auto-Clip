        { "kind": "Goal", "phrases": [ "达成目标", "目标达成" ], "maxPrefix": 3 },
        { "kind": "Advancement", "phrases": [ "取得进度", "达成进度", "进度达成" ], "maxPrefix": 3 },
        { "kind": "RaidVictory", "phrases": [ "袭击胜利" ], "maxPrefix": 2 },
        { "kind": "Death", "phrases": [ "你死了", "游戏结束" ], "maxPrefix": 2 },
        { "kind": "PlayerKill", "playerIsKiller": true, "phrases": [ "被" ], "requireAny": [ "杀死", "射杀", "炸死", "击杀", "杀害", "击毙", "刺穿", "打死" ] }
