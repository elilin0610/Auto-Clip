      "rules": [
        { "kind": "Challenge", "phrases": [ "完成挑戰", "挑戰完成" ], "maxPrefix": 3 },
        { "kind": "Goal", "phrases": [ "達成目標", "目標達成" ], "maxPrefix": 3 },
        { "kind": "Advancement", "phrases": [ "取得進度", "達成進度", "進度達成" ], "maxPrefix": 3 },
        { "kind": "RaidVictory", "phrases": [ "突襲勝利" ], "maxPrefix": 2 },
        { "kind": "Death", "phrases": [ "你死了", "遊戲結束" ], "maxPrefix": 2 },
        { "kind": "PlayerKill", "playerIsKiller": true, "phrases": [ "被" ], "requireAny": [ "殺死", "射殺", "炸死", "擊殺", "殺害", "擊斃", "刺穿", "打死" ] }
      ]
    },
    {
