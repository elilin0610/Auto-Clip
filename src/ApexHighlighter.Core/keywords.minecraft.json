{
  "_說明": "Minecraft 的畫面提示關鍵字表（格式同 keywords.json）。抓的是：死亡畫面（你死了／Game Over）、右上角的進度通知（取得進度／達成目標／完成挑戰）、突襲勝利的血條文字，以及聊天欄裡「你殺了別人」的死亡訊息（要在設定填 Minecraft 玩家名稱才會抓，名字在行首的是你自己死掉，不算擊殺）。Minecraft 的文字有大小寫，所以 upperCaseOnly 是 false。verified=false：還沒用實際錄影確認，用字是依遊戲語言檔推測的。",
  "_about": "Minecraft keyword rules (same format as keywords.json): the death screen, advancement / goal / challenge toasts, the raid victory boss bar, and chat death messages where the player is the killer (needs the Minecraft player name in Settings). Not yet checked against real recordings.",
  "game": "Minecraft",
  "weights": { "Death": 2.0, "PlayerKill": 1.5, "Advancement": 1.0, "Goal": 2.0, "Challenge": 3.0, "RaidVictory": 3.0 },
  "alwaysKeep": [ "Challenge", "RaidVictory" ],
  "spectate": {},
  "languages": [
    {
      "id": "en",
      "ocr": [ "en-US", "en-GB", "en" ],
      "verified": false,
      "upperCaseOnly": false,
      "anchors": [],
      "ignore": [ "HAS MADE THE ADVANCEMENT", "HAS REACHED THE GOAL", "HAS COMPLETED THE CHALLENGE" ],
      "rules": [
        { "kind": "Challenge", "phrases": [ "CHALLENGE COMPLETE" ], "maxPrefix": 3 },
        { "kind": "Goal", "phrases": [ "GOAL REACHED" ], "maxPrefix": 3 },
        { "kind": "Advancement", "phrases": [ "ADVANCEMENT MADE" ], "maxPrefix": 3 },
        { "kind": "RaidVictory", "phrases": [ "RAID VICTORY" ], "maxPrefix": 2 },
        { "kind": "Death", "phrases": [ "YOU DIED", "GAME OVER" ], "maxPrefix": 2 },
        {
          "kind": "PlayerKill",
          "playerIsKiller": true,
          "phrases": [
            "WAS SLAIN BY", "WAS SHOT BY", "WAS KILLED BY", "WAS BLOWN UP BY", "WAS FIREBALLED BY", "WAS IMPALED BY",
            "WAS PUMMELED BY", "WAS SKEWERED BY", "WAS STUNG TO DEATH BY", "WAS OBLITERATED BY", "WAS SQUASHED BY",
            "WAS KNOCKED INTO THE VOID BY", "WAS DOOMED TO FALL BY", "WAS STRUCK BY LIGHTNING WHILST FIGHTING",
            "WHILST FIGHTING", "WHILST TRYING TO ESCAPE", "TO ESCAPE", "WAS FINISHED BY", "WAS BLOWN FROM A HIGH PLACE BY"
          ]
        }
      ]
    },
    {
      "id": "zh-Hant",
      "ocr": [ "zh-Hant-TW", "zh-Hant", "zh-TW", "zh-HK" ],
      "verified": false,
      "upperCaseOnly": false,
      "anchors": [],
